<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tomas-samek</groupId>
        <artifactId>tiko-parent</artifactId>
        <version>0.6.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tiko-coverage</artifactId>
    <packaging>pom</packaging>

    <name>Tiko :: Coverage Aggregate</name>
    <description>
        Cross-module JaCoCo aggregate report (`report-aggregate`) covering the framework modules.
        Builds last in the reactor so every dependency's exec data already exists. Produces no
        published artifact — it exists only to collate coverage into one report at
        target/site/jacoco-aggregate. The runnable examples, archetype, and Kafka IT module are
        intentionally excluded; this measures the maintained library surface only.
    </description>

    <properties>
        <!-- Reporting-only module: never publish it. maven.deploy.skip stops the legacy deploy goal;
             skipPublishing stops the Central Portal plugin, which replaces it. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <skipPublishing>true</skipPublishing>
    </properties>

    <!-- The modules whose coverage is aggregated. report-aggregate reads each dependency's exec
         data from the reactor, so a class exercised by another module's tests (e.g. tiko-processor
         output exercised from tiko-runtime) is still attributed correctly. -->
    <dependencies>
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-processor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-test</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-kafka</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-kafka-processor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
