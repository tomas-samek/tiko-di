<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tomas-samek</groupId>
        <artifactId>tiko-parent</artifactId>
        <version>0.6.1-SNAPSHOT</version>
    </parent>

    <artifactId>tiko-archetype</artifactId>
    <packaging>maven-archetype</packaging>

    <name>Tiko DI - Archetype</name>
    <description>Maven archetype that scaffolds a runnable single-module Tiko DI project</description>

    <properties>
        <!-- maven-archetype-plugin 3.4.1 runs archetype-post-generate.groovy on Groovy 4.0.28, whose
             ASM stops at Java 25: on JDK 26+ the archetype IT fails with "Unsupported class file
             major version 70". 4.0.33 reads up to Java 27. Drop the override once the plugin
             ships a Groovy that covers the CI matrix. -->
        <archetype-groovy.version>4.0.33</archetype-groovy.version>
    </properties>

    <!-- Test-only deps: the doc-sync gate (#408) verifies the archetype-bundled agent-skill
         docs stay in sync with their canonical repo-root sources. Versions are BOM-managed. -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <extension>
                <groupId>org.apache.maven.archetype</groupId>
                <artifactId>archetype-packaging</artifactId>
                <version>3.4.1</version>
            </extension>
        </extensions>

        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-archetype-plugin</artifactId>
                    <version>3.4.1</version>
                    <!-- The whole Groovy family moves together; mixed versions don't load. -->
                    <dependencies>
                        <dependency>
                            <groupId>org.apache.groovy</groupId>
                            <artifactId>groovy</artifactId>
                            <version>${archetype-groovy.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.groovy</groupId>
                            <artifactId>groovy-json</artifactId>
                            <version>${archetype-groovy.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.groovy</groupId>
                            <artifactId>groovy-templates</artifactId>
                            <version>${archetype-groovy.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.groovy</groupId>
                            <artifactId>groovy-xml</artifactId>
                            <version>${archetype-groovy.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.groovy</groupId>
                            <artifactId>groovy-yaml</artifactId>
                            <version>${archetype-groovy.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- The maven-archetype packaging lifecycle does not bind compile/test phases
                 (archetypes are resource-only), so the doc-sync gate's test (#408) is wired
                 explicitly: compile src/test/java, then run it under surefire. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>doc-sync-test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>doc-sync-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <!--
          The maven-archetype packaging binds archetype:integration-test to the
          integration-test phase by default. The IT regenerates the archetype against
          src/test/resources/projects/basic/archetype.properties and runs `mvn compile`
          (per goal.txt) on the generated project. Catches regressions on every CI run.

          .gitignore: shipped in archetype-resources as `gitignore` (no leading dot)
          and renamed by META-INF/archetype-post-generate.groovy after generation.
          Maven archetype-plugin's default-excludes filter `**/.gitignore` out of the
          packaged archetype jar otherwise.
        -->
    </build>
</project>
