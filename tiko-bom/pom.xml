<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.tomas-samek</groupId>
    <artifactId>tiko-bom</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>

    <name>Tiko DI - BOM</name>
    <description>Bill of Materials for Tiko DI framework - centralized dependency management</description>
    <url>https://github.com/tomas-samek/tiko-di</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>tomas-samek</id>
            <name>Tomas Samek</name>
            <url>https://github.com/tomas-samek</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/tomas-samek/tiko-di.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/tomas-samek/tiko-di.git</developerConnection>
        <url>https://github.com/tomas-samek/tiko-di</url>
    </scm>

    <properties>
        <!-- Tiko DI version -->
        <tiko.version>0.2.0</tiko.version>

        <!-- Third-party dependency versions -->
        <auto-service.version>1.1.1</auto-service.version>
        <javapoet.version>0.1.0</javapoet.version>
        <slf4j.version>2.0.9</slf4j.version>
        <snakeyaml.version>2.3</snakeyaml.version>
        <junit.version>5.10.1</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <mockito.version>5.7.0</mockito.version>
        <mcp-sdk.version>0.18.2</mcp-sdk.version>

        <!-- Release-plugin versions (mirrored from the parent POM; tiko-bom intentionally
             has no <parent>, so it cannot inherit them). Keep in sync with root pom.xml. -->
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.10.0</central-publishing-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Tiko DI Modules -->
            <dependency>
                <groupId>io.github.tomas-samek</groupId>
                <artifactId>tiko-api</artifactId>
                <version>${tiko.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.tomas-samek</groupId>
                <artifactId>tiko-processor</artifactId>
                <version>${tiko.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.tomas-samek</groupId>
                <artifactId>tiko-runtime</artifactId>
                <version>${tiko.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.tomas-samek</groupId>
                <artifactId>tiko-config</artifactId>
                <version>${tiko.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.tomas-samek</groupId>
                <artifactId>tiko-mcp</artifactId>
                <version>${tiko.version}</version>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp</artifactId>
                <version>${mcp-sdk.version}</version>
            </dependency>

            <!-- Annotation Processing -->
            <dependency>
                <groupId>com.google.auto.service</groupId>
                <artifactId>auto-service-annotations</artifactId>
                <version>${auto-service.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.auto.service</groupId>
                <artifactId>auto-service</artifactId>
                <version>${auto-service.version}</version>
            </dependency>

            <!-- Code Generation -->
            <dependency>
                <groupId>com.palantir.javapoet</groupId>
                <artifactId>javapoet</artifactId>
                <version>${javapoet.version}</version>
            </dependency>

            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- Configuration -->
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${snakeyaml.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.github.tomas-samek</groupId>
                <artifactId>tiko-test</artifactId>
                <version>${tiko.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- Mirrors the `release` profile in the root pom.xml. tiko-bom has no <parent>, so the
             release-time plugin bindings (GPG signing + Central Portal upload) must be declared
             directly here, otherwise the default maven-deploy-plugin runs and fails on the
             missing <distributionManagement>. Keep this block in sync with the root profile. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <deploymentName>tiko-${project.version}</deploymentName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
