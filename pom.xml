    <artifactId>tiko-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>Tiko DI</name>
    <description>A modern, compile-time dependency injection framework for Java 21+ with event-driven architecture</description>
    <url child.project.url.inherit.append.path="false">https://github.com/tomas-samek/tiko-di</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>tomas-samek</id>
            <name>Tomas Samek</name>
            <url>https://github.com/tomas-samek</url>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/tomas-samek/tiko-di.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/tomas-samek/tiko-di.git</developerConnection>
        <url>https://github.com/tomas-samek/tiko-di</url>
    </scm>

    <modules>
        <module>tiko-bom</module>
        <module>tiko-api</module>
        <module>tiko-processor</module>
        <module>tiko-runtime</module>
        <module>tiko-config</module>
        <module>tiko-test</module>
        <module>tiko-kafka</module>
        <module>tiko-kafka-processor</module>
        <module>tiko-kafka-it</module>
        <module>tiko-examples</module>
        <module>tiko-archetype</module>
        <module>tiko-mcp</module>
        <module>tiko-coverage</module>
