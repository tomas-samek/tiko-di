<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tomas-samek</groupId>
        <artifactId>tiko-parent</artifactId>
        <version>0.6.1-SNAPSHOT</version>
    </parent>

    <artifactId>tiko-processor</artifactId>
    <name>Tiko Annotation Processor</name>
    <description>Compile-time annotation processor for Tiko DI</description>

    <properties>
        <!-- The shared test-support sources live in tiko-processor-core and are analysed there. -->
        <sonar.tests>src/test/java</sonar.tests>
    </properties>

    <dependencies>
        <!-- Tiko API -->
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-processor-core</artifactId>
        </dependency>
        <!-- Compile scope, not provided: the processor runs tiko-config's coercers on @Configuration
             records, so tiko-config must follow tiko-processor onto every processor path (#670). -->
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-config</artifactId>
        </dependency>

        <!-- Annotation processing -->
        <dependency>
            <groupId>com.google.auto.service</groupId>
            <artifactId>auto-service-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.auto.service</groupId>
            <artifactId>auto-service</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Code generation -->
        <dependency>
            <groupId>com.palantir.javapoet</groupId>
            <artifactId>javapoet</artifactId>
        </dependency>

        <!-- The KSP2 entry point (ksp/). Provided: KSP brings both at build time, and javac never
             loads the KSP entry, so the processor works on javac without them. -->
        <dependency>
            <groupId>com.google.devtools.ksp</groupId>
            <artifactId>symbol-processing-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Runtime deps needed so compile-testing can compile generated EventRegistry sources -->
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-runtime</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.testing.compile</groupId>
            <artifactId>compile-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Parses generated config-schema.json in tests (#496); test scope only, never in the processor jar. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- KSP2 tests: KspCompiler from tiko-processor-core's test-support sources, over kctfork. -->
        <dependency>
            <groupId>dev.zacsweers.kctfork</groupId>
            <artifactId>core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.zacsweers.kctfork</groupId>
            <artifactId>ksp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiles the KSP test helpers (KspCompiler, KspProgram, RecordingCodeGenerator, RoundWatcher) of tiko-processor-core into this
                 module's tests. They are shared as sources, not as a test-jar: a test-jar is an attached
                 artifact, and a release publishes every attached artifact (#703). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-ksp-test-support</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../tiko-processor-core/src/test-support/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Writes the processor's runtime dependency closure for ProcessorPathTest, which runs
                 javac with only that closure on the processor path, as annotationProcessorPaths and
                 ksp(...) do (#670). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>processor-path</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${project.build.directory}/processor-path.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
