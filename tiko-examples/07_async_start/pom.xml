    <description>Demonstrates @EventHandler(async = true) on ApplicationStartedEvent — heavy startup work runs off the critical path so Tiko.create() returns immediately</description>

    <dependencies>
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-processor</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

</project>
