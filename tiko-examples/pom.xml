<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tomas-samek</groupId>
        <artifactId>tiko-parent</artifactId>
        <version>0.2.1</version>
    </parent>

    <groupId>io.github.tomas-samek.examples</groupId>
    <artifactId>tiko-examples</artifactId>
    <packaging>pom</packaging>
    <name>Tiko DI - Examples</name>
    <description>Example applications demonstrating Tiko DI features</description>

    <modules>
        <module>01_basic_di</module>
        <module>02_config</module>
        <module>03_events</module>
        <module>04_api_impl</module>
        <module>05_multi_module</module>
        <module>06_config_multi_module</module>
        <module>07_async_start</module>
        <module>08_kafka_order_warehouse</module>
        <module>09_http_javalin</module>
        <module>10_persistence_jdbc</module>
        <module>11_custom_logger</module>
        <module>12_testing</module>
        <module>13_mcp_introspection</module>
        <module>14_profiles</module>
        <module>15_quickstart</module>
    </modules>

    <properties>
        <!-- Demonstration code, not the maintained library surface — skip SonarCloud analysis for
             every example module (inherited by all submodules). Their JaCoCo reports are likewise
             left out of the tiko-coverage aggregate. -->
        <sonar.skip>true</sonar.skip>
        <!-- Examples are demos, not published artifacts. All 13 child modules inherit this property
             and so stay out of the Central Portal bundle (central-publishing-maven-plugin reads it
             per module). -->
        <skipPublishing>true</skipPublishing>
    </properties>

    <!--
      No logging-binding deps inherited by examples. Tiko's framework code logs
      via java.util.logging (see #53), so examples need no extra binding to
      start. Users on slf4j stacks supply their own ErrorHandler via
      TikoOptions.errorHandler(...).
    -->

</project>
