    <artifactId>06_config_multi_module</artifactId>
    <packaging>pom</packaging>
    <name>06 - Multi-Module Configuration Example</name>
    <description>
        Each module ships its own META-INF/tiko/defaults.yaml inside its jar; a single
        external override file overrides individual values per key. Demonstrates the
        layered config model (#18).
    </description>

    <modules>
        <module>core</module>
        <module>notifications</module>
        <module>app</module>
    </modules>
</project>
