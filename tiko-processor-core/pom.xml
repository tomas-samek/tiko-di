<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tomas-samek</groupId>
        <artifactId>tiko-parent</artifactId>
        <version>0.6.1-SNAPSHOT</version>
    </parent>

    <artifactId>tiko-processor-core</artifactId>
    <name>Tiko Processor Core</name>
    <description>Shared layer for the Tiko annotation processors: the frontend-neutral declaration model, its javac adapter, and generator helpers</description>

    <dependencies>
        <!-- Code generation -->
        <dependency>
            <groupId>com.palantir.javapoet</groupId>
            <artifactId>javapoet</artifactId>
        </dependency>

        <!-- The KSP2 frontend (io.tiko.processor.core.ksp). Provided: KSP brings both at build time,
             and javac never loads the KSP classes, so the processor jars work without them. -->
        <dependency>
            <groupId>com.google.devtools.ksp</groupId>
            <artifactId>symbol-processing-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.testing.compile</groupId>
            <artifactId>compile-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test sources compile against @Component, @Pick and Provider; never a main-scope dependency. -->
        <dependency>
            <groupId>io.github.tomas-samek</groupId>
            <artifactId>tiko-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Runs KSP2 over Kotlin sources in tests (KspCompiler). -->
        <dependency>
            <groupId>dev.zacsweers.kctfork</groupId>
            <artifactId>core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.zacsweers.kctfork</groupId>
            <artifactId>ksp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiles the KSP test helpers (KspCompiler, KspProgram, RecordingCodeGenerator, RoundWatcher) of tiko-processor-core into this
                 module's tests. They are shared as sources, not as a test-jar: a test-jar is an attached
                 artifact, and a release publishes every attached artifact (#703). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-ksp-test-support</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/src/test-support/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
